{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "schedule": [
    "before 6am on thursday"
  ],
  "minimumReleaseAge": "3 days",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on thursday"]
  },
  // dev.flutter.flutter-plugin-loader (android/settings.gradle) is Flutter's own Gradle plugin
  // loader, pulled in directly from the local Flutter SDK install (includeBuild), not fetched from
  // Maven -- Renovate can't resolve it as a real package and warns on every run. Its version tracks
  // whatever Flutter SDK you're on (bumped via .fvmrc), not something Renovate should touch anyway.
  "ignoreDeps": [
    "dev.flutter.flutter-plugin-loader"
  ],
  "packageRules": [
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle + Android Gradle Plugin"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    },
    // Flutter (.fvmrc) and Dart (pubspec.yaml's environment.sdk) only move together: every Flutter
    // release bundles one specific Dart version, so a Dart-only bump can never pass CI (#122).
    // Grouping them gives one "Flutter SDK" PR instead of two. A Flutter minor still needs a
    // manual stop (environment ranges widened, codegen, real-device check), see docs/TODO.md's
    // 3.50 entry: treat a red grouped PR as the signal to do that stop, not as something to merge.
    {
      "matchDepNames": ["flutter", "dart"],
      "groupName": "Flutter SDK"
    },
    // Lock file maintenance has no single release timestamp to age against, so the
    // renovate/stability-days check stays pending forever on that PR.
    {
      "matchUpdateTypes": ["lockFileMaintenance"],
      "minimumReleaseAge": null
    }
  ]
}
