<!-- Legacy (pre-API 31) Auto Backup rules. FlutterSharedPreferences.xml is the one file every
     shared_preferences-backed setting lives in (time format, animation toggle, button mappings,
     wallpaper source id, and TV inputs, the last of which can include a Samsung TV's pairing
     token, see SamsungTizenProfile.secretParamKeys). Android's backup rules only work at file
     granularity, not per-key within a file, so excluding just the token means excluding this
     whole file; the app's own Backup/Restore feature (SettingsBackupService) already covers
     recovering those settings deliberately, and already strips secrets from that export. -->
<full-backup-content>
    <exclude domain="sharedpref" path="FlutterSharedPreferences.xml" />
</full-backup-content>
